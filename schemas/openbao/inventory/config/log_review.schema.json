{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inventory/config/log_review",
  "description": "Log Review Report(Host Audit 정기 실행, ADR-0015) 판정 기준 목록. 주소·관리번호가 들어가 공개 저장소에 둘 수 없어 문서에 둔다.",
  "type": "object",
  "properties": {
    "normal_sources": {
      "type": "array",
      "minItems": 1,
      "description": "정상 출발지(1부 7번). 이 목록 밖에서 온 서버 로그인 성공이 '확인 필요'가 된다. 비면 모든 로그인이 목록 밖이 되므로 1개 이상.",
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9A-Fa-f:.]+(/[0-9]{1,3})?(?!\\n)$",
            "description": "출발지 IP 또는 CIDR 대역"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "보고서에 찍히는 이름(예: 사무실)"
          }
        },
        "required": [
          "address"
        ],
        "additionalProperties": false
      }
    },
    "internal_addresses": {
      "type": "array",
      "description": "인벤토리에서 계산되지 않는 내부 주소 대응(1부 6번). 인벤토리 변수 ip와 호스트가 보고한 주소는 Host Audit이 계산하므로 여기에 두지 않는다.",
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9A-Fa-f:.]+(/[0-9]{1,3})?(?!\\n)$",
            "description": "내부 주소 IP 또는 CIDR 대역"
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "description": "그 주소의 관리 호스트(관리번호)"
          }
        },
        "required": [
          "address",
          "host"
        ],
        "additionalProperties": false
      }
    },
    "personal_info_systems": {
      "type": "array",
      "description": "개인정보처리시스템 표시(관리번호). 보고서 행에 '개인정보처리시스템' 표시가 붙는다.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "normal_sources"
  ],
  "additionalProperties": false
}
