{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inventory/config/openobserve_config",
  "type": "object",
  "properties": {
    "normal_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "minLength": 1,
            "description": "출발지 IP"
          },
          "kind": {
            "type": "string",
            "enum": [
              "semaphore",
              "office"
            ],
            "description": "구분용 표시(판정은 같다)"
          }
        },
        "required": [
          "address",
          "kind"
        ],
        "additionalProperties": false
      },
      "description": "정상 출발지"
    },
    "silent_host_exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1,
            "description": "관리번호"
          },
          "expires": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "만료일 YYYY-MM-DD"
          },
          "reason": {
            "type": "string",
            "description": "사유"
          }
        },
        "required": [
          "host",
          "expires"
        ],
        "additionalProperties": false
      },
      "description": "무음 예외(만료일 필수)"
    }
  },
  "additionalProperties": false
}
