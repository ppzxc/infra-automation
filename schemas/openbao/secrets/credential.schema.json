{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Credential (secrets/assets/<ns>/credentials/<이름>)",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "password"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "description": "계정이 아닌 비밀(enable 등)이면 생략."
        },
        "password": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "password"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "ssh_key"
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "private_key": {
          "type": "string",
          "minLength": 1,
          "description": "개인키 본문."
        },
        "passphrase": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "description": "승격용 비밀번호."
        }
      },
      "required": [
        "type",
        "username",
        "private_key"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "api_token"
        },
        "token": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "token"
      ],
      "additionalProperties": false
    }
  ]
}
