{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Automation Identity (secrets/automation/ssh)",
  "type": "object",
  "properties": {
    "private_key": {
      "type": "string",
      "minLength": 1,
      "description": "개인키 본문."
    },
    "public_key": {
      "type": "string",
      "minLength": 1
    },
    "passphrase": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "private_key"
  ],
  "additionalProperties": false
}
