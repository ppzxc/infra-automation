{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Service funa proxy(Caddy) 비밀",
  "type": "object",
  "description": "키는 snake_case, 렌더링 때 대응표로 env 이름이 된다. 노드별 Cloudflare 토큰은 여기 없다(Asset Credential cloudflare).",
  "properties": {
    "admin_token": {
      "type": "string",
      "minLength": 1
    },
    "db_password": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "admin_token",
    "db_password"
  ],
  "additionalProperties": false
}
