{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Service funa 소비자별 비밀",
  "type": "object",
  "description": "키는 snake_case, 렌더링 때 env 이름으로 바꾼다.",
  "patternProperties": {
    "^[a-z][a-z0-9_]*(?!\\n)$": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
