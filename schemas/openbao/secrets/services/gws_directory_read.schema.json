{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Service gws/directory_read (Google Workspace 디렉터리 읽기 서비스 계정)",
  "description": "sa_json은 서비스 계정 JSON이다. 문자열(원문 그대로) 또는 객체 둘 다 허용한다(소비 쪽 idc-access envload가 객체는 json.dumps로 문자열화해 파일에 쓴다). customer_id는 Workspace 고객 ID 문자열이다. 둘 다 필수다.",
  "type": "object",
  "properties": {
    "sa_json": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "project_id": {
              "type": "string",
              "minLength": 1
            },
            "private_key_id": {
              "type": "string",
              "minLength": 1
            },
            "private_key": {
              "type": "string",
              "minLength": 1
            },
            "client_email": {
              "type": "string",
              "minLength": 1
            },
            "client_id": {
              "type": "string",
              "minLength": 1
            },
            "auth_uri": {
              "type": "string",
              "minLength": 1
            },
            "token_uri": {
              "type": "string",
              "minLength": 1
            },
            "auth_provider_x509_cert_url": {
              "type": "string",
              "minLength": 1
            },
            "client_x509_cert_url": {
              "type": "string",
              "minLength": 1
            },
            "universe_domain": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "client_email",
            "private_key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "customer_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "sa_json",
    "customer_id"
  ],
  "additionalProperties": false
}
