---
all:
  children:
    # 1. 온프레미스 IDC 일반 서버 그룹 (Target Nodes)
    servers:
      hosts:
        web-01:
          ansible_host: 192.168.1.20
          ip: 192.168.1.20
          # Host Agents 필수(그룹 기본값 없음): production | staging | development | test (ADR-0006 §2.3)
          host_agents_environment: production
          fqdn: web-01.idc.internal
          ansible_user: ppzxc
          ansible_port: 22
        db-01:
          ansible_host: 192.168.1.30
          ip: 192.168.1.30
          host_agents_environment: production
          fqdn: db-01.idc.internal
          ansible_user: ppzxc
          ansible_port: 22

    # 2. 로드밸런서 그룹 (Keepalived, HAProxy, L4 VIP)
    loadbalancers:
      hosts:
        lb-01:
          ansible_host: 192.168.1.40
          ip: 192.168.1.40
          fqdn: lb-01.idc.internal
          ansible_user: ppzxc
          ansible_port: 22

    # 2-1. Host Agents 적용 제외 (ADR-0006 §2.1): servers에 있지만 아직 Host Agents를 적용하지 않는 호스트.
    #      Deploy·Config·Repo Maintenance가 모두 이 그룹을 뺀다. 적용할 때 여기서 제거한다.
    host_agents_excluded:
      hosts: {}

    # 2-2. 서버 도달성 검사 제외 (ADR-0010): ns0266(검사하는 쪽)에서 접속할 수 없는 것이 정상인 servers 호스트.
    #      Unreachable Host 알림 대상에서 빠진다(예: 내부 IP만 있어 포트 포워딩으로만 접근하는 서버). 접속 못 하는 이유가 해소되면 여기서 제거한다.
    tcpcheck_excluded:
      hosts: {}

    # 2-3. 프로비저닝 제외: 편입하면 안 되는 호스트(Semaphore 자신, 관리번호 재부여 대기 호스트 등).
    #      Host Provisioning(provision_hosts.yml)의 사전 검증이 이 그룹의 호스트를 target_hosts에 넣으면
    #      접속 전에 실패시킨다. 그룹이 없으면 빈 그룹으로 본다. 다른 제외 그룹과 달리 servers에 속하지
    #      않아도 되며, 영구 차단이 필요한 호스트만 둔다.
    provision_excluded:
      hosts: {}

    # 2-4. 프로비저닝 허용 목록(기본 거부): Host Provisioning은 이 그룹에 속한 호스트만 target_hosts로 받는다.
    #      비어 있음이 기본이며, 그룹이 없거나 비어 있으면 모든 프로비저닝이 접속 전에 거부된다.
    #      운영 절차: 호스트를 여기에 넣고(예: ns0001) 실행한 뒤 끝나면 다시 뺀다.
    #      provision_excluded는 영구 거부이며 이 그룹보다 우선한다(둘 다 속하면 거부).
    provision_allowed:
      hosts: {}
      # ns0001: {}   # 작업 중에만 임시로 추가

    # 3. 네트워크 인프라 스위치 그룹 (Cisco IOS Switches)
    cisco_switches:
      hosts:
        sw-core-01:
          ansible_host: 192.168.1.10
          ip: 192.168.1.10
          fqdn: sw-core-01.idc.internal
          ansible_port: 22
        sw-access-01:
          ansible_host: 192.168.1.11
          ip: 192.168.1.11
          fqdn: sw-access-01.idc.internal
          ansible_port: 22
          # 경유지(Bastion) 스위치를 경유해야 하는 경우 SSH ProxyJump 지정 예시:
          # ansible_ssh_common_args: '-o ProxyJump=admin@192.168.1.1:22'

    # 4. FortiGate 방화벽 그룹 (설정 백업, docs/fortigate_backup.md). 호스트 = 접속 대상(IDC HA 클러스터 1, 사무실 1).
    #    HA 관리 인터페이스가 없어 IDC 쌍은 클러스터(현재 active) 주소 하나로 접속한다. 호스트명은 관리번호(파일명의 <장비>).
    #    실제 응답 멤버는 접속 후 조회한다. 아래 주소는 문서용 예시다.
    fortigate_firewalls:
      hosts:
        ns0380:
          ansible_host: 192.0.2.11
        ns0399:
          ansible_host: 192.0.2.21
