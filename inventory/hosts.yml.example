---
all:
  children:
    # 1. 온프레미스 IDC 일반 서버 그룹 (Target Nodes)
    servers:
      hosts:
        web-01:
          ansible_host: 192.168.1.20
          ip: 192.168.1.20
          # Host Agents 필수(그룹 기본값 없음): production | staging | development | test (ADR-0006 §2.3)
          host_agents_environment: production
          fqdn: web-01.idc.internal
          ansible_user: ppzxc
          ansible_port: 22
        db-01:
          ansible_host: 192.168.1.30
          ip: 192.168.1.30
          host_agents_environment: production
          fqdn: db-01.idc.internal
          ansible_user: ppzxc
          ansible_port: 22

    # 2. 로드밸런서 그룹 (Keepalived, HAProxy, L4 VIP)
    loadbalancers:
      hosts:
        lb-01:
          ansible_host: 192.168.1.40
          ip: 192.168.1.40
          fqdn: lb-01.idc.internal
          ansible_user: ppzxc
          ansible_port: 22

    # 2-1. Host Agents 적용 제외 (ADR-0006 §2.1): servers에 있지만 아직 Host Agents를 적용하지 않는 호스트.
    #      Deploy·Config·Repo Maintenance가 모두 이 그룹을 뺀다. 적용할 때 여기서 제거한다.
    host_agents_excluded:
      hosts: {}

    # 3. 네트워크 인프라 스위치 그룹 (Cisco IOS Switches)
    cisco_switches:
      hosts:
        sw-core-01:
          ansible_host: 192.168.1.10
          ip: 192.168.1.10
          fqdn: sw-core-01.idc.internal
          ansible_port: 22
        sw-access-01:
          ansible_host: 192.168.1.11
          ip: 192.168.1.11
          fqdn: sw-access-01.idc.internal
          ansible_port: 22
          # 경유지(Bastion) 스위치를 경유해야 하는 경우 SSH ProxyJump 지정 예시:
          # ansible_ssh_common_args: '-o ProxyJump=admin@192.168.1.1:22'

