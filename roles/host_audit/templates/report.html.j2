<!DOCTYPE html>
{#- Host Audit A4 통합 보고서 (ADR-0009, 레이아웃 A안 — 섹션 우선).
    host_audit_model을 그리기만 한다. 판단·집계·라벨은 filter_plugins/host_audit.py가 정한다.
    외부 리소스 없음(폰트·이미지·스크립트 모두 내장 또는 시스템 폰트). -#}
{%- set m = host_audit_model -%}
<html lang="ko">
<head>
<meta charset="utf-8">
<title>{{ m.title | e }} · {{ m.cover.run_id | e }}</title>
<style>
  @page { size: A4; margin: 16mm 14mm 18mm 14mm;
    @bottom-center { content: "{{ m.title | e }} · {{ m.cover.run_id | e }} · " counter(page) " / " counter(pages); font-size: 8pt; color: #666; } }
  :root { --ink:#1b1f24; --mute:#5b6470; --line:#c9cfd6; --soft:#f3f5f7; --crit:#b42318; --ok:#2f7d32; --na:#7a7f87; }
  * { box-sizing: border-box; }
  body { margin:0; color:var(--ink); font: 9.5pt/1.45 "Malgun Gothic","Apple SD Gothic Neo","Noto Sans KR","Noto Sans CJK KR","NanumGothic",sans-serif; background:#e9ecef; }
  .sheet { width:210mm; min-height:297mm; margin:12px auto; padding:16mm 14mm 18mm; background:#fff; box-shadow:0 1px 4px rgba(0,0,0,.15); }
  @media print { body { background:#fff; } .sheet { margin:0; padding:0; width:auto; min-height:0; box-shadow:none; } }
  .pb { break-before: page; }
  .keep { break-inside: avoid; }
  h1 { font-size:20pt; margin:0 0 4mm; }
  h2 { font-size:13pt; margin:7mm 0 2.5mm; padding-bottom:1mm; border-bottom:1.5px solid var(--ink); }
  p { margin:1.5mm 0; }
  .mute { color:var(--mute); } .small { font-size:8pt; }
  table { width:100%; border-collapse:collapse; margin:1.5mm 0 3mm; font-size:8.5pt; }
  thead { display: table-header-group; } tr { break-inside: avoid; }
  th, td { border:1px solid var(--line); padding:1.2mm 1.6mm; text-align:left; vertical-align:top; }
  th { background:var(--soft); font-weight:600; }
  .tag { display:inline-block; padding:0 1.6mm; border-radius:2mm; font-size:7.5pt; font-weight:600; border:1px solid currentColor; white-space:nowrap; }
  .nowrap { white-space:nowrap; }
  .crit { color:var(--crit); } .ok { color:var(--ok); } .na { color:var(--na); }
  .kv { display:grid; grid-template-columns: 34mm 1fr; gap:.6mm 3mm; font-size:9pt; }
  .kv div:nth-child(odd) { color:var(--mute); }
  .tiles { display:grid; grid-template-columns: repeat(3,1fr); gap:3mm; margin:3mm 0; }
  .tile { border:1px solid var(--line); padding:2.5mm; } .tile b { display:block; font-size:16pt; } .tile span { font-size:8pt; color:var(--mute); }
  .note { border-left:4px solid var(--na); background:var(--soft); padding:2mm 3mm; margin:2mm 0; font-size:8.5pt; }
  .sign { width:100%; border-collapse:collapse; margin-top:4mm; }
  .sign td, .sign th { height:16mm; border:1px solid var(--ink); }
  .sign th { height:auto; width:18%; }
</style>
</head>
<body>
<div class="sheet">

  <div class="mute small">ISMS 2.11.2 점검 결과 보고서 · 대외비</div>
  <h1>{{ m.title | e }}</h1>
  <div class="kv keep">
    <div>점검일시</div><div>{{ m.cover.started_at | e }} 시작 · {{ m.cover.generated_at | e }} 작성 · {{ m.cover.run_kind | e }} ({{ m.cover.run_id | e }})</div>
    <div>점검대상</div><div>{{ m.cover.scope | e }}<br><span class="small mute">범위 밖: {{ m.cover.out_of_scope | e }}</span></div>
    <div>점검방법</div><div>{{ m.cover.method | e }}</div>
    <div>점검내용</div><div>{% for c in m.cover.contents %}{{ c | e }}{% if not loop.last %}<br>{% endif %}{% endfor %}</div>
    <div>비교 기준</div><div>{{ m.cover.baseline | e }}</div>
    <div>점검 계정</div><div>{{ m.cover.accounts | e }}</div>
    <div>원본 보관</div><div>{{ m.cover.archive | e }}</div>
{% include 'sections/asset_inventory_cover.html.j2' %}
  </div>

  <h2>1. 요약</h2>
  <div class="tiles">
    <div class="tile"><b>{{ m.summary.hosts_total }}</b><span>점검 대상 호스트</span></div>
    <div class="tile"><b class="ok">{{ m.summary.hosts_inspected }}</b><span>점검 완료</span></div>
    <div class="tile"><b class="{{ 'crit' if m.summary.hosts_unavailable else 'na' }}">{{ m.summary.hosts_unavailable }}</b><span>점검불가</span></div>
  </div>
{% include 'sections/asset_inventory_summary.html.j2' %}
{% if m.unavailable %}
  <div class="note keep"><b>점검불가 항목</b> — 아래 호스트·항목은 이번 실행에서 확인하지 못했습니다.</div>
  <table>
    <thead><tr><th>호스트</th><th>항목</th><th>판정</th><th>이유</th></tr></thead>
    <tbody>
{% for u in m.unavailable %}
      <tr><td class="nowrap">{{ u.host | e }}</td><td class="nowrap">{{ u.item | e }}</td><td><span class="tag na">{{ u.label | e }}</span></td><td class="small">{{ u.reason | e }}</td></tr>
{% endfor %}
    </tbody>
  </table>
{% else %}
  <div class="note keep">점검불가 항목 없음.</div>
{% endif %}

{% include 'sections/asset_inventory.html.j2' %}

{% include 'sections/appendix.html.j2' %}

  <h2 class="pb keep">검토 및 결재</h2>
  <p class="small mute">발견사항별 조치 의견(조치 / 예외 승인 / 선언 수정)과 검토 결과를 기재한다. 결재된 본 문서가 ISMS 2.11.2 검토 증적이다.</p>
  <table class="sign keep">
    <tr><th>구분</th><th>성명·직책</th><th>일자</th><th>의견</th><th>서명</th></tr>
    <tr><th>검토자</th><td></td><td></td><td></td><td></td></tr>
    <tr><th>정보보호 책임자</th><td></td><td></td><td></td><td></td></tr>
  </table>

</div>
</body>
</html>
