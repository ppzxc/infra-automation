<!DOCTYPE html>
{#- Log Review Report A4 (Spec #544, ADR-0015). Host Audit 메일의 세 번째 첨부.
    host_audit_log_review_model을 그리기만 한다. 항목 순서·상태·사유·판정은 filter_plugins/host_audit_log_review*.py가 정한다.
    항목은 모두 같은 틀(상태·점검 방법·판정 기준·결과 표·사람이 쓰는 칸)로 그린다: 판정 모듈이 늘어도 이 파일은 바뀌지 않는다.
    결과 표 아래의 소제목 표(i.sections, 장비 관리자 로그인 몫 등)도 같은 틀이다(#562).
    외부 리소스 없음(시스템 폰트). 최종 판정·소견·조치·서명란은 언제나 빈 칸이다. -#}
{%- set m = host_audit_log_review_model -%}
{%- macro item_block(i) -%}
<section class="item keep" data-part="{{ i.part }}" data-no="{{ i.no }}" data-status="{{ i.status }}">
  <h3>{{ i.no }}) {{ i.title | e }}</h3>
  <table class="meta">
    <tr><th>상태</th><td><span class="tag st-{{ i.status }}">{{ i.status_label | e }}</span>{% if i.verdict %} <b class="{{ 'crit' if i.verdict == '확인 필요' else 'ok' }}">자동 판정: {{ i.verdict | e }}</b>{% endif %}{% if i.summary %} <span class="mute">· {{ i.summary | e }}</span>{% endif %}</td></tr>
    <tr><th>점검 방법</th><td>{{ i.method | e if i.method else '-' }}</td></tr>
    <tr><th>판정 기준</th><td class="criterion">{{ i.criterion | e if i.criterion else '-' }}</td></tr>
  </table>
{%- if i.rows %}
  <table class="rows">
    <thead><tr>{% for c in i.columns %}<th>{{ c | e }}</th>{% endfor %}</tr></thead>
    <tbody>{% for r in i.rows %}<tr>{% for v in r %}<td>{{ v | e }}</td>{% endfor %}</tr>{% endfor %}</tbody>
  </table>
{%- endif %}
{%- for s in i.sections | default([]) %}
  <div class="section" data-kind="{{ s.kind | e }}" data-status="{{ s.status | e }}">
    <h4>{{ s.title | e }}</h4>
    <p class="small"><span class="tag st-{{ s.status }}">{{ s.status_label | e }}</span>{% if s.verdict %} <b class="{{ 'crit' if s.verdict == '확인 필요' else 'ok' }}">자동 판정: {{ s.verdict | e }}</b>{% endif %}{% if s.summary %} <span class="mute">· {{ s.summary | e }}</span>{% endif %}</p>
{%- if s.rows %}
    <table class="rows">
      <thead><tr>{% for c in s.columns %}<th>{{ c | e }}</th>{% endfor %}</tr></thead>
      <tbody>{% for r in s.rows %}<tr>{% for v in r %}<td>{{ v | e }}</td>{% endfor %}</tr>{% endfor %}</tbody>
    </table>
{%- endif %}
  </div>
{%- endfor %}
  <table class="human">
    <tr><th>최종 판정</th><td class="final-verdict">{{ i.final_verdict | e }}</td></tr>
    <tr><th>점검자 소견</th><td class="remarks">{{ i.remarks | e }}</td></tr>
    <tr><th>조치 내역</th><td class="action">{{ i.action | e }}</td></tr>
  </table>
</section>
{%- endmacro -%}
<html lang="ko">
<head>
<meta charset="utf-8">
<title>{{ m.title | e }} · {{ m.period.month | e }} · {{ m.run_id | e }}</title>
<style>
  @page { size: A4; margin: 16mm 14mm 18mm 14mm;
    @bottom-center { content: "Log Review Report · {{ m.period.month | e }} · " counter(page) " / " counter(pages); font-size: 8pt; color: #666; } }
  :root { --ink:#1b1f24; --mute:#5b6470; --line:#c9cfd6; --soft:#f3f5f7; --crit:#b42318; --ok:#2f7d32; --na:#7a7f87; --warn:#b54708; }
  * { box-sizing: border-box; }
  body { margin:0; color:var(--ink); font: 9.5pt/1.45 "Malgun Gothic","Apple SD Gothic Neo","Noto Sans KR","Noto Sans CJK KR","NanumGothic",sans-serif; background:#e9ecef; }
  .sheet { width:210mm; min-height:297mm; margin:12px auto; padding:16mm 14mm 18mm; background:#fff; box-shadow:0 1px 4px rgba(0,0,0,.15); }
  @media print { body { background:#fff; } .sheet { margin:0; padding:0; width:auto; min-height:0; box-shadow:none; } }
  .pb { break-before: page; }
  .keep { break-inside: avoid; }
  h1 { font-size:18pt; margin:0 0 4mm; }
  h2 { font-size:13pt; margin:7mm 0 2.5mm; padding-bottom:1mm; border-bottom:1.5px solid var(--ink); }
  h3 { font-size:10pt; margin:4mm 0 1.2mm; }
  h4 { font-size:9pt; margin:2mm 0 .8mm; }
  .mute { color:var(--mute); } .small { font-size:8pt; }
  table { width:100%; border-collapse:collapse; margin:1mm 0 2mm; font-size:8.5pt; }
  thead { display: table-header-group; } tr { break-inside: avoid; }
  th, td { border:1px solid var(--line); padding:1.2mm 1.6mm; text-align:left; vertical-align:top; }
  th { background:var(--soft); font-weight:600; }
  table.meta th, table.human th { width:26mm; }
  table.human td { height:9mm; }
  .tag { display:inline-block; padding:0 1.6mm; border-radius:2mm; font-size:7.5pt; font-weight:600; border:1px solid currentColor; white-space:nowrap; }
  .st-auto { color:var(--ok); } .st-partial { color:var(--warn); } .st-manual { color:var(--ink); } .st-unavailable { color:var(--na); } .st-failed { color:var(--crit); }
  .crit { color:var(--crit); } .ok { color:var(--ok); }
  .kv { display:grid; grid-template-columns: 30mm 1fr; gap:.6mm 3mm; font-size:9pt; }
  .kv div:nth-child(odd) { color:var(--mute); }
  .note { border-left:4px solid var(--na); background:var(--soft); padding:2mm 3mm; margin:2mm 0; font-size:8.5pt; }
  table.policy td.blank { height:9mm; }
  table.sign th, table.sign td { border:1px solid var(--ink); text-align:center; }
  table.sign td { height:22mm; }
</style>
</head>
<body>
<div class="sheet">

  <div class="mute small">ISMS-P 2.9.5 로그 및 접속기록 점검 · 회사 양식 AK-034 대응 · 대외비</div>
  <h1>{{ m.title | e }}</h1>
  <div class="kv keep">
    <div>점검 기간</div><div class="period">{{ m.period.label | e }}</div>
    <div>점검 대상</div><div>{{ m.scope | e }}</div>
    <div>데이터</div><div>{{ m.source | e }}</div>
    <div>작성</div><div>Host Audit {{ m.run_kind | e }} 실행 {{ m.run_id | e }} · {{ m.started_at | e }} 시작 · {{ m.generated_at | e }} 작성</div>
{%- if m.archive %}
    <div>원본 보관</div><div>{{ m.archive | e }}</div>
{%- endif %}
    <div>항목 상태</div><div>{% for c in m.counts %}{{ c.label | e }} {{ c.count }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
  </div>
  <div class="note">자동 집계·자동 판정(이상 없음/확인 필요)은 초안이다. 최종 판정·점검자 소견·조치 내역은 점검자가 쓰고, 마지막 쪽에서 점검자 → 정보보호관리자 → 정보보호책임자(CISO) 순으로 서명한다. 점검할 수 없는 항목은 빼지 않고 "점검 불가"와 사유로, 조회가 실패한 항목은 "조회 실패"로 남긴다.</div>

  <h2 class="pb">1부 로그 검토 항목 (AK-034 1~19)</h2>
{%- for i in m.part1 %}
{{ item_block(i) }}
{%- endfor %}

  <h2 class="pb">2부 보안시스템 정책 적정성 검토 (AK-034 1~9)</h2>
  <p class="small mute">방화벽 정책 자체를 읽는 Security Policy Review다(로그 검토가 아니다). 1차 구현은 점검자가 채우는 빈 표다.</p>
  <table class="policy">
    <thead><tr><th style="width:8mm">No</th><th>검토 항목</th><th style="width:22mm">해당 정책 수</th><th style="width:22mm">최종 판정</th><th>점검자 소견</th><th>조치 내역</th></tr></thead>
    <tbody>
{%- for i in m.part2 %}
      <tr class="policy-item" data-no="{{ i.no }}"><td>{{ i.no }}</td><td>{{ i.title | e }}</td><td class="blank"></td><td class="blank final-verdict">{{ i.final_verdict | e }}</td><td class="blank remarks">{{ i.remarks | e }}</td><td class="blank action">{{ i.action | e }}</td></tr>
{%- endfor %}
    </tbody>
  </table>
  <p class="small mute">점검 방법: {{ (m.part2 | first).method | e if m.part2 else '-' }} · 상태: {{ (m.part2 | first).status_label | e if m.part2 else '-' }}</p>

  <h2 class="pb">3부 로그 관리 상태</h2>
{%- for i in m.part3 %}
{{ item_block(i) }}
{%- endfor %}

  <section class="approval pb keep">
    <h2>결재</h2>
    <p class="small mute">점검 기간 {{ m.period.label | e }} · 실행 {{ m.run_id | e }}. 서명 스캔본은 같은 실행 보관 경로의 signed/에 등록한다.</p>
{%- for i in m.part3 if i.key == 'part3.previous_signed_copy' and i.summary %}
    <p class="previous-signed small">{{ i.summary | e }}</p>
{%- endfor %}
    <table class="sign">
      <thead><tr>{% for a in m.approvals %}<th>{{ a.role | e }}</th>{% endfor %}</tr></thead>
      <tbody>
        <tr class="sign-name">{% for a in m.approvals %}<td>{{ a.name | e }}</td>{% endfor %}</tr>
        <tr class="sign-date"><td colspan="{{ m.approvals | length }}" style="height:auto;text-align:left">일자</td></tr>
        <tr class="sign-date">{% for a in m.approvals %}<td style="height:9mm">{{ a.date | e }}</td>{% endfor %}</tr>
      </tbody>
    </table>
  </section>

</div>
</body>
</html>
