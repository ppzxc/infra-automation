{#- 항목 단위 부록 `부록 N+1. 조치 안내` (Spec #488 / Ticket-3, #491). 호스트별 부록 뒤, 검토 및 결재 앞.
    host_audit_model.config_vulnerability.remediation_guide를 그리기만 한다(본문 표와 같은 항목·같은 순서).
    계열별 steps는 호스트 계열로 고르지 않고 있는 것을 전부 싣는다. 호스트별 증적은 싣지 않는다. -#}
{%- set rg = m.config_vulnerability.remediation_guide | default([]) -%}
  <h2 class="pb">부록 {{ m.hosts | length + 1 }}. 조치 안내</h2>
{#- 번호 N은 호스트별 부록 수다. appendix.html.j2가 m.hosts를 빠짐없이 돌므로 같은 값이다. -#}
{% if rg %}
  <p class="small mute">이번 실행에서 양호 외 판정(취약·점검불가(수동)·예외(승인))이 나온 항목마다 한 블록이며 본문 「양호 외 항목」 표와 같은 순서다. 호스트별 증적은 호스트별 부록을 본다.</p>
{% for b in rg %}
  <section class="rg-block" data-code="{{ b.code | e }}">
    <h3><span class="nowrap">{{ b.code | e }}</span> {{ b.title | e }} {% if b.severity or b.guide_page is not none %}<span class="small mute">{% if b.severity %}중요도 {{ b.severity | e }}{% endif %}{% if b.guide_page is not none %}{% if b.severity %} · {% endif %}가이드 p.{{ b.guide_page | e }}{% endif %}</span>{% endif %}</h3>
    <div class="rg-hosts">{% for v in b.verdict_hosts %}<span class="tag {{ v.verdict_class }}">{{ v.verdict | e }}</span>: {{ v.hosts | map('e') | join(', ') }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
    <dl>
{% if b.purpose %}      <dt>점검 목적</dt><dd>{{ b.purpose | e }}</dd>
{% endif %}
{% if b.threat %}      <dt>보안 위협</dt><dd>{{ b.threat | e }}</dd>
{% endif %}
{% if b.criteria %}      <dt>판단 기준</dt><dd>{{ b.criteria | e }}</dd>
{% endif %}
{% if b.check %}      <dt>점검방법</dt><dd>{{ b.check | e }}</dd>
{% endif %}
{% if b.summary or b.steps %}      <dt>조치방법</dt><dd>{{ b.summary | e }}
{%- for st in b.steps %}
        <div><b>{{ st.family | e }}</b></div><div class="rg-steps">{{ st.text | e }}</div>
{%- endfor %}</dd>
{% endif %}
      <dt>조치 영향도</dt><dd>{% if b.impact %}{{ b.impact.level | e }} — {{ b.impact.reason | e }}{% else %}-{% endif %}</dd>
      <dt>조치 난이도</dt><dd>{% if b.effort %}{{ b.effort.level | e }} — {{ b.effort.reason | e }}{% else %}-{% endif %}</dd>
    </dl>
  </section>
{% endfor %}
{% elif m.config_vulnerability.hosts_checked %}
  <div class="note keep">조치 안내 대상 없음 — 이번 실행에서 양호 외 판정이 나온 항목이 없다.</div>
{% else %}
  <div class="note keep">조치 안내를 만들지 못했다 — 이번 실행에서 점검을 마친 호스트가 없다.</div>
{% endif %}
