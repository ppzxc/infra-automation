{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HostAuditListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::host-audit"]
    },
    {
      "Sid": "HostAuditPutGetObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": ["arn:aws:s3:::host-audit/*"]
    }
  ]
}
