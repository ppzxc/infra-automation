# Ansible managed — 시크릿 전용 (mode 0600). 본 설정은 ${env:O2_BASIC_AUTH}로만 참조한다.
O2_BASIC_AUTH={{ (o2_org ~ ':' ~ host_agents_secrets.o2_ingest_token) | b64encode }}
{% if (host_agents_inputs.otel_github_webhook | default(false) | bool) and (host_agents_os_path | default('modern')) == 'modern' %}
{{ otel_github_webhook_env.endpoint.name }}={{ host_agents_github_webhook.address ~ ':' ~ host_agents_github_webhook.port }}
{{ otel_github_webhook_env.path.name }}={{ host_agents_github_webhook.path }}
{{ otel_github_webhook_env.secret.name }}={{ host_agents_github_webhook.secret | to_json }}
{% endif %}
