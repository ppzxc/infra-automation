# Ansible managed — 시크릿 전용 (mode 0600). openobserve-health-check가 읽는다.
O2_HEALTH_URL={{ (o2_endpoint ~ '/healthz') | quote }}
O2_HEALTH_CA_FILE={{ o2_ca_file | quote }}
O2_HEALTH_STATE_DIR={{ o2_health_state_dir | quote }}
O2_HEALTH_RENOTIFY_MINUTES={{ o2_health_renotify_minutes | string | quote }}
O2_WEBHOOK_URL={{ host_agents_shared_secrets.openobserve.alert_webhook_url | quote }}
O2_WEBHOOK_AUTH_HEADER={{ host_agents_shared_secrets.openobserve.alert_webhook_auth_header | default('Authorization', true) | quote }}
O2_WEBHOOK_TOKEN={{ host_agents_shared_secrets.openobserve.alert_webhook_token | default('', true) | quote }}
