[Unit]
Description=OpenTelemetry Collector Contrib
{% if (host_agents_inputs.otel_github_webhook | default(false) | bool) and (host_agents_os_path | default('modern')) == 'modern' %}
# GitHub 웹훅 수신기(Spec #399)는 도커 브리지 주소에 바인드한다. 브리지보다 먼저 뜨면 바인딩 실패로 수집기 전체(모든 로그 수집)가 멈추므로 도커 뒤에 시작한다.
# 도커가 늦거나 재시작해도 Restart=always가 바인딩 실패를 다시 시도한다.
After=network.target docker.service
Wants=docker.service
{% else %}
After=network.target
{% endif %}

[Service]
{% if otelcol_run_as_root | default(false) | bool %}
User=root
Group=root
{% else %}
User={{ otelcol_user }}
Group={{ otelcol_group }}
{% endif %}
Type=simple
EnvironmentFile={{ otelcol_secrets_path }}
ExecStart=/usr/local/bin/otelcol-contrib --config={{ otelcol_config_path }}
Restart=always
RestartSec=5
LimitNOFILE=65535
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
{% if not (otelcol_run_as_root | default(false) | bool) %}
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
{% endif %}

[Install]
WantedBy=multi-user.target
