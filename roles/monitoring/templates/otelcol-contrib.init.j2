#!/bin/bash
#
# otelcol-contrib OpenTelemetry Collector Contrib
#
# chkconfig: 2345 90 10
# description: OpenTelemetry Collector Contrib
# processname: otelcol-contrib
# pidfile: /var/run/otelcol-contrib.pid

### BEGIN INIT INFO
# Provides:          otelcol-contrib
# Required-Start:    $network $local_fs $remote_fs
# Required-Stop:     $network $local_fs $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: OpenTelemetry Collector Contrib
### END INIT INFO

# Source function library
if [ -f /etc/init.d/functions ]; then
    . /etc/init.d/functions
fi

PROG="otelcol-contrib"
EXEC="{{ host_agents_bin_dir | default('/usr/local/bin') }}/$PROG"
CONFIG="{{ otelcol_config_path }}"
SECRETS="{{ otelcol_secrets_path }}"
PIDFILE="{{ otelcol_sysv_pid_path | default('/var/run/otelcol-contrib.pid') }}"
LOGFILE="{{ otelcol_sysv_log_path | default('/var/log/otelcol-contrib.log') }}"
# start 후 이 시간(초) 안에 프로세스가 죽으면 start를 실패시킨다(조용한 수집 중단 방지, Spec #161).
START_GRACE={{ otelcol_sysv_start_grace | default(3) }}
# TERM 후 종료를 기다리는 최대 시간(초). 넘기면 KILL하고 소멸을 확인한다.
STOP_TIMEOUT={{ otelcol_sysv_stop_timeout | default(30) }}
{% if not (otelcol_run_as_root | default(false) | bool) %}
USER="{{ otelcol_user }}"
{% endif %}

[ -e /etc/sysconfig/$PROG ] && . /etc/sysconfig/$PROG

# 설정의 ${env:O2_BASIC_AUTH} 등은 secrets env(0600, root)에서만 공급된다(systemd의 EnvironmentFile 대응).
if [ -r "$SECRETS" ]; then
    set -a
    . "$SECRETS"
    set +a
fi

start() {
    [ -x $EXEC ] || exit 5
    [ -f $CONFIG ] || exit 6
    echo -n $"Starting $PROG: "
    if [ -f $PIDFILE ] && kill -0 $(cat $PIDFILE) 2>/dev/null; then
        echo -n $"$PROG is already running."
        echo
        return 0
    fi
    rm -f $PIDFILE
    # setsid로 세션·제어 터미널과 분리한다(pty 세션 종료 시 SIGHUP 경쟁으로 조용히 죽는 것을 방지).
    # setsid가 fork할 수 있으므로 pid는 sh -c가 exec 전에 직접 pidfile에 기록한다($$는 exec 후에도 같은 pid).
{% if otelcol_run_as_root | default(false) | bool %}
    # CentOS 6: 커널 2.6.32에는 ambient capability가 없어 root로 실행한다(ADR-0006 §2.9).
    # stdin까지 끊어야 백그라운드 자식이 raw(SSH) 세션의 파이프를 붙잡지 않는다.
    setsid /bin/sh -c 'echo $$ > "$1"; exec "$2" --config="$3"' sh "$PIDFILE" "$EXEC" "$CONFIG" >> $LOGFILE 2>&1 </dev/null &
{% else %}
    setsid /bin/sh -c 'echo $$ > "$1"; exec su -s /bin/sh "$2" -c "$3 --config=$4"' sh "$PIDFILE" "$USER" "$EXEC" "$CONFIG" >> $LOGFILE 2>&1 </dev/null &
{% endif %}
    sleep $START_GRACE
    PID=$(cat $PIDFILE 2>/dev/null)
    if [ -z "$PID" ] || ! kill -0 $PID 2>/dev/null; then
        rm -f $PIDFILE
        echo_failure 2>/dev/null || echo -n "[ FAILED ]"
        echo
        echo "$PROG exited within ${START_GRACE}s of start; last lines of $LOGFILE:" >&2
        tail -n 20 $LOGFILE >&2
        return 1
    fi
    echo_success 2>/dev/null || echo -n "[ OK ]"
    echo
    return 0
}

stop() {
    echo -n $"Stopping $PROG: "
    if [ -f $PIDFILE ]; then
        PID=$(cat $PIDFILE)
        kill -TERM $PID 2>/dev/null
        # 종료(큐 flush, file_storage 잠금 해제)를 기다려야 restart의 새 프로세스가 storage를 열 수 있다.
        n=0
        while kill -0 $PID 2>/dev/null && [ $n -lt $STOP_TIMEOUT ]; do
            sleep 1
            n=$((n + 1))
        done
        if kill -0 $PID 2>/dev/null; then
            kill -KILL $PID 2>/dev/null
            # KILL 직후에도 소멸(잠금 해제)을 확인한 뒤에만 pidfile을 지운다.
            n=0
            while kill -0 $PID 2>/dev/null && [ $n -lt 10 ]; do
                sleep 1
                n=$((n + 1))
            done
            if kill -0 $PID 2>/dev/null; then
                echo_failure 2>/dev/null || echo -n "[ FAILED ]"
                echo
                echo "$PROG (pid $PID) did not exit after KILL" >&2
                return 1
            fi
        fi
        rm -f $PIDFILE
        echo_success 2>/dev/null || echo -n "[ OK ]"
    else
        echo_failure 2>/dev/null || echo -n "[ FAILED ]"
    fi
    echo
    return 0
}

status_fn() {
    if [ -f $PIDFILE ] && kill -0 $(cat $PIDFILE) 2>/dev/null; then
        echo "$PROG (pid $(cat $PIDFILE)) is running..."
        return 0
    else
        echo "$PROG is stopped"
        return 3
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    status)
        status_fn
        ;;
    restart)
        stop || exit 1
        sleep 1
        start
        ;;
    *)
        echo $"Usage: $0 {start|stop|status|restart}"
        exit 2
esac
exit $?
