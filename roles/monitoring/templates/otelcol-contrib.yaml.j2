# Ansible managed — ISMS 수집 표준 (ADR-0006 §2.3, §2.7). 시크릿은 포함하지 않으며 ${env:…}로 secrets.env를 참조한다.
{% macro o2_common(stream=none) %}
    endpoint: {{ (o2_endpoint ~ '/api/' ~ o2_org) | to_json }}
    headers:
      Authorization: "Basic ${env:O2_BASIC_AUTH}"
{% if stream %}
      stream-name: {{ stream }}
{% endif %}
{% if o2_ca_file | length > 0 %}
    tls:
      ca_file: {{ o2_ca_file | to_json }}
{% endif %}
{% endmacro %}
extensions:
  file_storage:
    directory: {{ otelcol_storage_dir }}
    compaction:
      on_rebound: true
      directory: {{ otelcol_storage_dir }}
      rebound_needed_threshold_mib: 100
      rebound_trigger_threshold_mib: 10

receivers:
{% for stream, entries in host_agents_inputs.otel_logs | groupby('stream') %}
  filelog/{{ stream }}:
    include:
{% for entry in entries %}
      - {{ entry.path | to_json }}
{% endfor %}
    start_at: end
    include_file_path: true
    storage: file_storage
    attributes:
      log_type: {{ stream }}
    retry_on_failure:
      enabled: true
{% endfor %}
{% if host_agents_journald | default(false) | bool %}
  journald:
    start_at: end
    storage: file_storage
    operators:
      - type: add
        field: attributes.log_type
        value: system_logs
{% endif %}
  hostmetrics:
    collection_interval: {{ otel_hostmetrics_interval }}
    scrapers:
{{ otel_hostmetrics_scrapers | to_nice_yaml(indent=2) | indent(6, true) }}
{% if host_agents_inputs.otel_docker_metrics | bool %}
  docker_stats:
    endpoint: {{ otel_docker_endpoint }}
    collection_interval: {{ otel_hostmetrics_interval }}
{% endif %}
{% if otel_otlp_enabled | bool %}
  otlp:
    protocols:
      grpc:
        endpoint: "{{ otel_otlp_bind }}:{{ otel_otlp_grpc_port }}"
      http:
        endpoint: "{{ otel_otlp_bind }}:{{ otel_otlp_http_port }}"
{% endif %}

processors:
  memory_limiter:
    check_interval: 1s
    limit_percentage: 75
    spike_limit_percentage: 20
  batch:
    send_batch_size: 1024
    timeout: 1s
  resource/host:
    attributes:
      - key: host.name
        value: {{ inventory_hostname | to_json }}
        action: upsert
      - key: os.type
        value: {{ host_agents_os_type | to_json }}
        action: upsert
      - key: os.description
        value: {{ host_agents_os_description | to_json }}
        action: upsert

connectors:
  routing/logs:
    default_pipelines: [logs/app_logs]
    table:
{% for stream in host_agents_log_streams if stream != 'app_logs' %}
      - context: log
        condition: attributes["log_type"] == "{{ stream }}"
        pipelines: [logs/{{ stream }}]
{% endfor %}

exporters:
{% for stream in host_agents_log_streams %}
  # 로그: 소형 영속 bytes 큐 + block_on_overflow + 무한 재시도. 큐가 차면 filelog가 멈추고 원본 파일이 버퍼가 된다.
  otlphttp/{{ stream }}:
{{ o2_common(stream) }}    sending_queue:
      enabled: true
      storage: file_storage
      sizer: bytes
      queue_size: {{ otel_log_queue_bytes }}
      block_on_overflow: true
    retry_on_failure:
      enabled: true
      max_elapsed_time: 0
{% endfor %}
  # 메트릭: 로그와 분리된 메모리 큐, 역압 없이 폐기 가능.
  otlphttp/metrics:
{{ o2_common() }}    sending_queue:
      enabled: true
      block_on_overflow: false

service:
  extensions: [file_storage]
  pipelines:
    logs/in:
      receivers: [{% for stream, _ in host_agents_inputs.otel_logs | groupby('stream') %}filelog/{{ stream }}, {% endfor %}{% if host_agents_journald | default(false) | bool %}journald, {% endif %}{% if otel_otlp_enabled | bool %}otlp, {% endif %}]
      processors: [memory_limiter, resource/host]
      exporters: [routing/logs]
{% for stream in host_agents_log_streams %}
    logs/{{ stream }}:
      receivers: [routing/logs]
      processors: [batch]
      exporters: [otlphttp/{{ stream }}]
{% endfor %}
    metrics:
      receivers: [hostmetrics{% if host_agents_inputs.otel_docker_metrics | bool %}, docker_stats{% endif %}{% if otel_otlp_enabled | bool %}, otlp{% endif %}]
      processors: [memory_limiter, resource/host, batch]
      exporters: [otlphttp/metrics]
