# Ansible managed — ISMS 수집 표준 (ADR-0006 §2.3, §2.7). 시크릿은 포함하지 않으며 ${env:…}로 secrets.env를 참조한다.
{% macro o2_common(stream=none) %}
    endpoint: {{ (o2_endpoint ~ '/api/' ~ o2_org) | to_json }}
    headers:
      Authorization: "Basic ${env:O2_BASIC_AUTH}"
{% if stream %}
      stream-name: {{ stream }}
{% endif %}
{% if o2_ca_file | length > 0 %}
    tls:
      ca_file: {{ o2_ca_file | to_json }}
{% endif %}
{% endmacro %}
extensions:
  file_storage:
    directory: {{ otelcol_storage_dir }}
    compaction:
      on_rebound: true
      directory: {{ otelcol_storage_dir }}
      rebound_needed_threshold_mib: 100
      rebound_trigger_threshold_mib: 10

receivers:
{% for stream, entries in host_agents_inputs.otel_logs | groupby('stream') %}
  filelog/{{ stream }}:
    include:
{% for entry in entries %}
      - {{ entry.path | to_json }}
{% endfor %}
    start_at: end
    include_file_path: true
    storage: file_storage
    attributes:
      log_type: {{ stream }}
    # service.name은 파일 그룹별로 붙인다. 수신기 ID(filelog/<stream>)는 file_storage 체크포인트 키라 바꾸지 않고,
    # 본문은 건드리지 않는다(원문 유지). 글롭은 host_agents_glob_regex가 정규식으로 옮긴다.
    operators:
{% for entry in entries %}
      - type: add
        field: resource["service.name"]
        value: {{ (entry.service | default(stream | replace('_logs', ''), true)) | to_json }}
        if: {{ ('attributes["log.file.path"] matches "' ~ (entry.path | host_agents_glob_regex) ~ '"') | to_json }}
{% endfor %}
    retry_on_failure:
      enabled: true
{% endfor %}
  # 백업 결과 jsonl (backup 역할의 run-finally 훅이 append). 본문(원문 JSON)은 유지하고 필드를 attributes로 파싱한다.
  filelog/backup_logs:
    include:
      - {{ otel_backup_log_path | to_json }}
    start_at: end
    include_file_path: true
    storage: file_storage
    attributes:
      log_type: backup_logs
    operators:
      - type: json_parser
        parse_from: body
        parse_to: attributes
        timestamp:
          parse_from: attributes.ts
          layout_type: gotime
          layout: '2006-01-02T15:04:05Z07:00'
      - type: add
        field: resource["service.name"]
        value: {{ otel_service_backup | to_json }}
    retry_on_failure:
      enabled: true
{% if host_agents_journald | default(false) | bool %}
  journald:
    start_at: end
    storage: file_storage
    operators:
      - type: add
        field: attributes.log_type
        value: system_logs
      - type: add
        field: resource["service.name"]
        value: {{ otel_service_journald | to_json }}
{% endif %}
  hostmetrics:
    collection_interval: {{ otel_hostmetrics_interval }}
    scrapers:
{{ otel_hostmetrics_scrapers | to_nice_yaml(indent=2) | indent(6, true) }}
{% if host_agents_inputs.otel_docker_metrics | bool %}
  docker_stats:
    endpoint: {{ otel_docker_endpoint }}
    collection_interval: {{ otel_hostmetrics_interval }}
{% endif %}
{% if otel_otlp_enabled | bool %}
  otlp:
    protocols:
      grpc:
        endpoint: "{{ otel_otlp_bind }}:{{ otel_otlp_grpc_port }}"
      http:
        endpoint: "{{ otel_otlp_bind }}:{{ otel_otlp_http_port }}"
{% endif %}

processors:
  memory_limiter:
    check_interval: 1s
    limit_percentage: 75
    spike_limit_percentage: 20
  batch:
    send_batch_size: 1024
    timeout: 1s
  # 호스트 단위 리소스 속성(ADR-0006 §2.3). 값은 MON-036이 검증·조립한다(host.id/host.ip는 없으면 생략).
  resource/host:
    attributes:
{% for key, value in host_agents_resource_attrs.attributes.items() %}
      - key: {{ key }}
        value: {{ value | to_json }}
        action: upsert
{% endfor %}
  # 메트릭 service.name: hostmetrics와 docker_stats를 구분한다. OTLP로 들어온 앱 메트릭의 service.name은 건드리지 않는다.
  resource/hostmetrics:
    attributes:
      - key: service.name
        value: {{ otel_service_hostmetrics | to_json }}
        action: upsert
  resource/docker:
    attributes:
      - key: service.name
        value: {{ otel_service_docker | to_json }}
        action: upsert

connectors:
  routing/logs:
    default_pipelines: [logs/app_logs]
    table:
{% for stream in host_agents_log_streams if stream != 'app_logs' %}
      - context: log
        condition: attributes["log_type"] == "{{ stream }}"
        pipelines: [logs/{{ stream }}]
{% endfor %}

exporters:
{% for stream in host_agents_log_streams %}
  # 로그: 소형 영속 bytes 큐 + block_on_overflow + 무한 재시도. 큐가 차면 filelog가 멈추고 원본 파일이 버퍼가 된다.
  otlphttp/{{ stream }}:
{{ o2_common(stream) }}    sending_queue:
      enabled: true
      storage: file_storage
{% if host_agents_os_path | default('modern') == 'legacy_el6' %}
      # v0.119.0(legacy_el6): bytes 큐와 신규 역압 키 미지원 → 배치 개수 큐 + 구 이름 blocking (validate로 확인, ADR-0006 §2.8)
      queue_size: {{ otel_log_queue_batches_legacy_el6 }}
      blocking: true
{% else %}
      sizer: bytes
      queue_size: {{ otel_log_queue_bytes }}
      block_on_overflow: true
{% endif %}
    retry_on_failure:
      enabled: true
      max_elapsed_time: 0
{% endfor %}
  # 메트릭: 로그와 분리된 메모리 큐, 역압 없이 폐기 가능.
  otlphttp/metrics:
{{ o2_common() }}    sending_queue:
      enabled: true
{% if host_agents_os_path | default('modern') == 'legacy_el6' %}
      blocking: false
{% else %}
      block_on_overflow: false
{% endif %}

service:
  extensions: [file_storage]
  pipelines:
    logs/in:
      receivers: [{% for stream, _ in host_agents_inputs.otel_logs | groupby('stream') %}filelog/{{ stream }}, {% endfor %}filelog/backup_logs, {% if host_agents_journald | default(false) | bool %}journald, {% endif %}{% if otel_otlp_enabled | bool %}otlp, {% endif %}]
      processors: [memory_limiter, resource/host]
      exporters: [routing/logs]
{% for stream in host_agents_log_streams %}
    logs/{{ stream }}:
      receivers: [routing/logs]
      processors: [batch]
      exporters: [otlphttp/{{ stream }}]
{% endfor %}
    metrics/host:
      receivers: [hostmetrics]
      processors: [memory_limiter, resource/host, resource/hostmetrics, batch]
      exporters: [otlphttp/metrics]
{% if host_agents_inputs.otel_docker_metrics | bool %}
    metrics/docker:
      receivers: [docker_stats]
      processors: [memory_limiter, resource/host, resource/docker, batch]
      exporters: [otlphttp/metrics]
{% endif %}
{% if otel_otlp_enabled | bool %}
    metrics/otlp:
      receivers: [otlp]
      processors: [memory_limiter, resource/host, batch]
      exporters: [otlphttp/metrics]
{% endif %}
